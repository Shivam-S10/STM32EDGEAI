/**
* @brief Function implementing the AI_TASK thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartTask02 */
void StartTask02(void *argument)
{
  /* USER CODE BEGIN StartTask02 */
	for(;;)
	  {
	      // 1. Sleep until the FeatureTask says the feature_vector is ready
	      osThreadFlagsWait(AI_READY_FLAG, osFlagsWaitAny, osWaitForever);

	      // 2. Map data and run AI Inference
	      ai_input[0].data = AI_HANDLE_PTR(feature_vector);
	      ai_output[0].data = AI_HANDLE_PTR(ml_output);

	      ai_i32 n_batch = ai_network_run(network_handle, &ai_input[0], &ai_output[0]);

	      if (n_batch == 1)
	      {
	          // 3. Determine if it is an anomaly
	          // Assuming your model outputs 2 classes: Index 0 = Normal, Index 1 = Anomaly
	          int predicted_class = (ml_output[1] > ml_output[0]) ? 1 : 0;

	          if (predicted_class == 1)
	          {
	              // ANOMALY DETECTED: Red Light ON, Green Light OFF
	              HAL_GPIO_WritePin(GPIOE, GPIO_PIN_3, GPIO_PIN_SET);   // Example Red Pin
	              HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, GPIO_PIN_RESET);  // Example Green Pin

	              // Optional: Send a quick alert over UART
	              char alert_msg[] = "ANOMALY DETECTED!\r\n";
	              HAL_UART_Transmit(&huart1, (uint8_t*)alert_msg, strlen(alert_msg), 100);
	          }
	          else
	          {
	              // NORMAL OPERATION: Green Light ON, Red Light OFF
	              HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, GPIO_PIN_SET);    // Example Green Pin
	              HAL_GPIO_WritePin(GPIOE, GPIO_PIN_3, GPIO_PIN_RESET); // Example Red Pin
	          }
	      }
	  }
  /* USER CODE END StartTask02 */
}

