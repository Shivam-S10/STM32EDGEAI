/**
  * @brief  Function implementing the defaultTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartDefaultTask */
void StartDefaultTask(void *argument)
{
  /* USER CODE BEGIN 5 */
	SensorData_t sensor_packet = {0};
	  uint8_t mpu_buf[6] = {0};
	  uint8_t wake = 0x00;
	  osStatus_t status;
	  // 1. Give the system a moment to settle after power-on
	  osDelay(100);

	  // 2. Initial Hardware Setup (MPU6050)
	  if (HAL_I2C_IsDeviceReady(&hi2c1, MPU6050_ADDR, 5, 100) != HAL_OK) {
	      char err_msg[] = "I2C ERROR: MPU6050 NOT FOUND!\r\n";
	      HAL_UART_Transmit(&huart1, (uint8_t*)err_msg, strlen(err_msg), 1000);
	      // We don't return/stop here so the system can potentially recover later
	  }

	  // Wake up the MPU6050 (Exit Sleep Mode)
	  HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, 0x6B, 1, &wake, 1, 100);

	  // 3. Start ADC DMA in "Silent Mode"
	  // Stop first to ensure clean state
	  HAL_ADC_Stop_DMA(&hadc1);
	  __HAL_ADC_CLEAR_FLAG(&hadc1, (ADC_FLAG_OVR | ADC_FLAG_EOS | ADC_FLAG_EOC));

	  // Start DMA - it will update adc_buffer[0] continuously in hardware
	  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 1);

	  // CRITICAL: Disable the ADC DMA interrupt.
	  // This prevents the CPU from being flooded with interrupts every few microseconds.
	  HAL_NVIC_DisableIRQ(DMA1_Channel1_IRQn);

	  // Initialize the 1kHz timer variable
	  uint32_t tick_count = osKernelGetTickCount();

	  /* Infinite loop */
	  for(;;)
	  {
	    // 4. Start Non-Blocking I2C Read (Interrupt Mode)
	    // We request 6 bytes (Accel X, Y, Z) starting from register 0x3B
	    if(HAL_I2C_Mem_Read_IT(&hi2c1, MPU6050_ADDR, 0x3B, 1, mpu_buf, 6) == HAL_OK)
	    {
	      // 5. Wait for the I2C Interrupt to signal completion
	      // This puts the task to sleep, allowing UARTTask to run.
	      status = osThreadFlagsWait(I2C_DONE_FLAG, osFlagsWaitAny, 5);

	      if (status != osErrorTimeout)
	      {
	        // Data is ready! Process raw bytes into 16-bit integers
	        sensor_packet.ax = (int16_t)((int16_t)mpu_buf[0] << 8 | mpu_buf[1]);
	        sensor_packet.ay = (int16_t)((int16_t)mpu_buf[2] << 8 | mpu_buf[3]);
	        sensor_packet.az = (int16_t)((int16_t)mpu_buf[4] << 8 | mpu_buf[5]);

	        // 6. Collect Microphone Data
	        // This is updated automatically by the background DMA
	        sensor_packet.mic = (uint16_t)adc_buffer[0];


	        // 7. preparing buffer
	        ax_buffer[sample_index] = (float)sensor_packet.ax;
	        ay_buffer[sample_index] = (float)sensor_packet.ay;
	        az_buffer[sample_index] = (float)sensor_packet.az;

	        mic_buffer[sample_index] = (float)sensor_packet.mic;

	        accel_mag[sample_index] =
	        sqrtf(
	            ax_buffer[sample_index] * ax_buffer[sample_index] +
	            ay_buffer[sample_index] * ay_buffer[sample_index] +
	            az_buffer[sample_index] * az_buffer[sample_index]
	        );

	        sample_index++;

	        if(sample_index >= WINDOW_SIZE)
	        {
	        	memcpy(feature_window.ax,
	        	       ax_buffer,
	        	       sizeof(ax_buffer));

	        	memcpy(feature_window.ay,
	        	       ay_buffer,
	        	       sizeof(ay_buffer));

	        	memcpy(feature_window.az,
	        	       az_buffer,
	        	       sizeof(az_buffer));

	        	memcpy(feature_window.mic,
	        	       mic_buffer,
	        	       sizeof(mic_buffer));

	        	memcpy(feature_window.accel_mag,
	        	       accel_mag,
	        	       sizeof(accel_mag));

	        	uint8_t dummy = 1;

	        	if(osMessageQueuePut(
	        	    FeatureQueueHandle,
	        	    &dummy,
	        	    0,
	        	    0) != osOK)
	        	{
	        	    droppedSamples++;
	        	}


	            // Shift second half -> first half
	            memmove(ax_buffer,
	                    &ax_buffer[HOP_SIZE],
	                    HOP_SIZE * sizeof(float));

	            memmove(ay_buffer,
	                    &ay_buffer[HOP_SIZE],
	                    HOP_SIZE * sizeof(float));

	            memmove(az_buffer,
	                    &az_buffer[HOP_SIZE],
	                    HOP_SIZE * sizeof(float));

	            memmove(mic_buffer,
	                    &mic_buffer[HOP_SIZE],
	                    HOP_SIZE * sizeof(float));

	            memmove(accel_mag,
	                    &accel_mag[HOP_SIZE],
	                    HOP_SIZE * sizeof(float));

	            // Next samples continue from middle
	            sample_index = HOP_SIZE;
	        }

	      }
	      else
	      {
	          // I2C timed out - possible bus hang or hardware disconnected
	          HAL_I2C_Init(&hi2c1);
	      }
	    }
	    else
	    {
	        // I2C Peripheral busy or error
	        HAL_I2C_Init(&hi2c1);
	    }

	    // 8. Maintain strict 1kHz Loop Timing (1ms per iteration)
	    tick_count += 1;
	    osDelayUntil(tick_count);
	  }
  /* USER CODE END 5 */
}

