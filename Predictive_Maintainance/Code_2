//-----------------------------------------------intermediate FFT functions-----------------------------------------------------
float ComputeMean(float *data)
{
    float sum = 0;

    for(int i=0;i<WINDOW_SIZE;i++)
    {
        sum += data[i];
    }

    return sum / WINDOW_SIZE;
}

float ComputeRMS(float *data)
{
    float sum = 0;

    for(int i=0;i<WINDOW_SIZE;i++)
    {
        sum += data[i] * data[i];
    }

    return sqrtf(sum / WINDOW_SIZE);
}

float ComputePeak(float *data)
{
    float peak = 0;

    for(int i=0;i<WINDOW_SIZE;i++)
    {
        float val = fabsf(data[i]);

        if(val > peak)
            peak = val;
    }

    return peak;
}

float ComputeSTD(float *data)
{
    float sum = 0.0f;

    for(int i = 0; i < WINDOW_SIZE; i++)
    {
        sum += data[i] * data[i];
    }

    return sqrtf(sum / WINDOW_SIZE);
}

float ComputeKurtosis(float *data, float std)
{
    float sum = 0.0f;

    if(std < 0.000001f)
        return 0.0f;

    for(int i = 0; i < WINDOW_SIZE; i++)
    {
        float normalized = data[i] / std;

        sum += normalized *
               normalized *
               normalized *
               normalized;
    }

    return sum / WINDOW_SIZE;
}

void CenterData(float *input, float *output)
{
    float mean = ComputeMean(input);

    for(int i = 0; i < WINDOW_SIZE; i++)
    {
        output[i] = input[i] - mean;
    }
}

void ComputeAccelFFT(float *input, float *output_bins)
{
    float selected[6];
    float total = 0.0f;

    float windowed[FFT_SIZE];

    for(int i=0;i<FFT_SIZE;i++)
        windowed[i] = input[i] * hann_window[i];

    for(int i=0;i<FFT_SIZE;i++)
    {
        fft_in[i].r = windowed[i];
        fft_in[i].i = 0.0f;
    }

    kiss_fft(fft_cfg, fft_in, fft_out);

    int bins[6] = {9,10,11,80,81,82};

    for(int i=0;i<6;i++)
    {
        float re = fft_out[bins[i]].r;
        float im = fft_out[bins[i]].i;

        selected[i] =
        sqrtf(re*re + im*im)/(FFT_SIZE/2.0f);

        total += selected[i];
    }

    total += 1e-8f;

    for(int i=0;i<6;i++)
    {
        output_bins[i] =
        selected[i]/total;
    }
}

void ComputeMicFFT(float *input, float *output_bins)
{
    float selected[4];
    float total = 0.0f;

    float windowed[FFT_SIZE];

    for(int i=0;i<FFT_SIZE;i++)
        windowed[i] = input[i] * hann_window[i];

    for(int i=0;i<FFT_SIZE;i++)
    {
        fft_in[i].r = windowed[i];
        fft_in[i].i = 0.0f;
    }

    kiss_fft(fft_cfg, fft_in, fft_out);

    int bins[3] = {9,10,11};

    for(int i=0;i<3;i++)
    {
        float re = fft_out[bins[i]].r;
        float im = fft_out[bins[i]].i;

        selected[i] =
        sqrtf(re*re + im*im)/(FFT_SIZE/2.0f);

        total += selected[i];
    }

    float band_sum = 0.0f;

    for(int i=45;i<60;i++)
    {
        float re = fft_out[i].r;
        float im = fft_out[i].i;

        band_sum +=
        sqrtf(re*re + im*im)/(FFT_SIZE/2.0f);
    }

    selected[3] = band_sum;
    total += band_sum;

    total += 1e-8f;

    for(int i=0;i<4;i++)
    {
        output_bins[i] =
        selected[i]/total;
    }
}

float SpectralCentroid(float *input)
{
    float mag_sum = 0.0f;
    float weighted_sum = 0.0f;

    float windowed[FFT_SIZE];

    for(int i=0;i<FFT_SIZE;i++)
        windowed[i] = input[i] * hann_window[i];

    for(int i=0;i<FFT_SIZE;i++)
    {
        fft_in[i].r = windowed[i];
        fft_in[i].i = 0;
    }

    kiss_fft(fft_cfg, fft_in, fft_out);

    for(int i=0;i<=FFT_SIZE/2;i++)
    {
        float mag =
        sqrtf(
        fft_out[i].r*fft_out[i].r +
        fft_out[i].i*fft_out[i].i);

        float freq =
        (1000.0f * i)/FFT_SIZE;

        mag_sum += mag;
        weighted_sum += freq * mag;
    }

    return weighted_sum/(mag_sum + 1e-8f);
}

float SpectralEntropy(float *input)
{
    float psd[FFT_SIZE/2 + 1];
    float total = 0.0f;
    float entropy = 0.0f;

    float windowed[FFT_SIZE];

    for(int i=0;i<FFT_SIZE;i++)
        windowed[i] = input[i] * hann_window[i];

    for(int i=0;i<FFT_SIZE;i++)
    {
        fft_in[i].r = windowed[i];
        fft_in[i].i = 0;
    }

    kiss_fft(fft_cfg, fft_in, fft_out);

    for(int i=0;i<=FFT_SIZE/2;i++)
    {
        float mag =
        sqrtf(
        fft_out[i].r*fft_out[i].r +
        fft_out[i].i*fft_out[i].i);

        psd[i] = mag * mag;
        total += psd[i];
    }

    total += 1e-8f;

    for(int i=0;i<= FFT_SIZE/2;i++)
    {
        float p = psd[i]/total;

        if(p > 0.0f)
        {
            entropy -= p * logf(p);
        }
    }

    return entropy;
}

void ExtractFeatures(void)
{
    CenterData(mic_buffer, mic_centered);
    CenterData(accel_mag, accel_mag_centered);

    //--------------------------------
    // Accel magnitude statistics
    //--------------------------------

    float peak_A =
    ComputePeak(accel_mag_centered);

    float std_A =
    ComputeSTD(accel_mag_centered);

    float kurt_A =
    ComputeKurtosis(accel_mag_centered,
                    std_A);

    //--------------------------------
    // Mic statistics
    //--------------------------------

    float peak_mic =
    ComputePeak(mic_centered);

    float std_mic =
    ComputeSTD(mic_centered);

    float kurt_mic =
    ComputeKurtosis(mic_centered,
                    std_mic);

    //--------------------------------
    // FFT Features
    //--------------------------------

    ComputeAccelFFT(accel_mag_centered,
                    accel_fft_bins);

    ComputeMicFFT(mic_centered,
                  mic_fft_bins);

    //--------------------------------
    // Spectral Features
    //--------------------------------

    float centroid_A =
    SpectralCentroid(accel_mag_centered);

    float centroid_mic =
    SpectralCentroid(mic_centered);

    float entropy_A =
    SpectralEntropy(accel_mag_centered);

    float entropy_mic =
    SpectralEntropy(mic_centered);

    //--------------------------------
    // Build feature vector
    //--------------------------------

    feature_vector[0] = peak_A;
    feature_vector[1] = std_A;
    feature_vector[2] = kurt_A;

    feature_vector[3] = peak_mic;
    feature_vector[4] = std_mic;
    feature_vector[5] = kurt_mic;

    feature_vector[6]  = accel_fft_bins[0];
    feature_vector[7]  = accel_fft_bins[1];
    feature_vector[8]  = accel_fft_bins[2];
    feature_vector[9]  = accel_fft_bins[3];
    feature_vector[10] = accel_fft_bins[4];
    feature_vector[11] = accel_fft_bins[5];

    feature_vector[12] = mic_fft_bins[0];
    feature_vector[13] = mic_fft_bins[1];
    feature_vector[14] = mic_fft_bins[2];
    feature_vector[15] = mic_fft_bins[3];

    feature_vector[16] = centroid_A;
    feature_vector[17] = centroid_mic;

    feature_vector[18] = entropy_A;
    feature_vector[19] = entropy_mic;
}

void StandardizeFeatures(void)
{
    for(int i = 0; i < FEATURE_COUNT; i++)
    {
        if(SCALER_STD[i] > 0.000001f)
        {
            feature_vector[i] =
            (feature_vector[i] - SCALER_MEAN[i]) /
            SCALER_STD[i];
        }
        else
        {
        	feature_vector[i]=0.0f;
        }
    }
}

