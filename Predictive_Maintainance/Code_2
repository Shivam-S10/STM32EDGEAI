/* USER CODE BEGIN Header_StartDefaultTask */
/**
  * @brief  Function implementing the defaultTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartDefaultTask */
void StartDefaultTask(void *argument)
{
  /* USER CODE BEGIN 5 */
	SensorData_t sensor_packet = {0};
	  uint8_t mpu_buf[6] = {0};
	  uint8_t wake = 0x00;

	  // 1. Wait for peripherals to stabilize
	  osDelay(100);

	  // 2. CHECK SENSOR READY
	  if (HAL_I2C_IsDeviceReady(&hi2c1, MPU6050_ADDR, 5, 100) != HAL_OK) {
	      char err_msg[] = "I2C ERROR: MPU6050 NOT FOUND!\r\n";
	      HAL_UART_Transmit(&huart1, (uint8_t*)err_msg, strlen(err_msg), 1000);
	      osDelay(2000);
	  }

	  // 3. WAKE UP MPU6050
	  HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, 0x6B, 1, &wake, 1, 100);

	  // 4. START ADC DMA (And instantly silence the interrupt storm!)
	  HAL_ADC_Stop_DMA(&hadc1);
	  __HAL_ADC_CLEAR_FLAG(&hadc1, (ADC_FLAG_OVR | ADC_FLAG_EOS | ADC_FLAG_EOC));
	  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 1);

	  // CRITICAL: Keep this to prevent FreeRTOS from crashing
	  HAL_NVIC_DisableIRQ(DMA1_Channel1_IRQn);

	  uint32_t tick_count = osKernelGetTickCount();

	  for(;;)
	  {
	    // 5. READ MPU6050
	    if(HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, 0x3B, 1, mpu_buf, 6, 5) == HAL_OK)
	    {
	      sensor_packet.ax = (int16_t)((int16_t)mpu_buf[0] << 8 | mpu_buf[1]);
	      sensor_packet.ay = (int16_t)((int16_t)mpu_buf[2] << 8 | mpu_buf[3]);
	      sensor_packet.az = (int16_t)((int16_t)mpu_buf[4] << 8 | mpu_buf[5]);

	      // Grab latest Mic data from silent DMA memory
	      sensor_packet.mic = (uint16_t)adc_buffer[0];

	      // 6. PUSH TO QUEUE
	      if (osMessageQueuePut(SensorQueueHandle, &sensor_packet, 0, 0) != osOK) {
	          droppedSamples++;
	      }
	    }
	    else
	    {
	        HAL_I2C_Init(&hi2c1); // Recovery
	    }

	    // 7. Loop exactly at 1kHz (1ms)
	    tick_count += 1;
	    osDelayUntil(tick_count);
	  }
  /* USER CODE END 5 */
}

/* USER CODE BEGIN Header_StartTask02 */
/**
* @brief Function implementing the AI_TASK thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartTask02 */
void StartTask02(void *argument)
{
  /* USER CODE BEGIN StartTask02 */
	SensorData_t received;
	  static char csv_msg[128];
	  int len;

	  // IMPORTANT: Set the flag initially so the very first loop can proceed
	  osThreadFlagsSet(UARTTaskHandle, UART_DONE_FLAG);

	  for(;;)
	  {
	    // 1. Wait for data from the queue
	    if(osMessageQueueGet(SensorQueueHandle, &received, NULL, osWaitForever) == osOK)
	    {
	      // 2. Wait for previous DMA to finish (Timeout of 5ms to prevent total lockups)
	      osStatus_t status = osThreadFlagsWait(UART_DONE_FLAG, osFlagsWaitAny, 5);

	      if (status == osErrorTimeout) {
	          // If DMA missed the interrupt, force reset the hardware state and flag
	          huart1.gState = HAL_UART_STATE_READY;
	          osThreadFlagsSet(UARTTaskHandle, UART_DONE_FLAG);
	          continue; // Skip this one transmission to let the queue catch up
	      }

	      // 3. Convert to String
	      len = snprintf(csv_msg, sizeof(csv_msg), "%d,%d,%d,%u\r\n",
	                     received.ax, received.ay, received.az, received.mic);

	      // 4. Send using DMA
	      if (len > 0) {
	        HAL_UART_Transmit_DMA(&huart1, (uint8_t*)csv_msg, len);
	      }
	    }
	  }
  /* USER CODE END StartTask02 */
}

